# EditorConfig — https://editorconfig.org
# Consistent whitespace across editors for the OS 1 monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.{js,ts,jsx,tsx,json,jsonc,css,html,kdl}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
