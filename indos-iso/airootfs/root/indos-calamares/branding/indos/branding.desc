---
componentName: indos

welcomeStyleCalamares: false

welcomeExpandingLogo: true

windowExpanding: normal

windowSize: 1100px,580px

windowPlacement: center

sidebar: qml,bottom

navigation: widget

strings:
    productName:         OS 1
    shortProductName:    OS 1
    version:             2026.05
    shortVersion:        2026.05
    versionedName:       OS 1
    shortVersionedName:  OS 1
    bootloaderEntryName: OS 1
    productUrl:          https://github.com/user/IndOS
    supportUrl:          https://github.com/user/IndOS/issues
    knownIssuesUrl:      https://github.com/user/IndOS/issues
    releaseNotesUrl:     https://github.com/user/IndOS/releases

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

style:
    SidebarBackground:        "#0d1117"
    SidebarText:              "#c9d1d9"
    SidebarTextCurrent:       "#0d1117"
    SidebarBackgroundCurrent: "#d1684e"

slideshow:               "show.qml"

slideshowAPI: 2

uploadServer:
    type:    "none"
