#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════════╗
# ║  indos-dev — IndOS Development Toolkit                       ║
# ║  Fast iteration on ISO builds, Calamares configs, and QEMU   ║
# ╚═══════════════════════════════════════════════════════════════╝

set -euo pipefail

INDOS_ROOT="$(cd "$(dirname "$0")" && pwd)"
ISO_DIR="${INDOS_ROOT}/indos-iso"
BUILD_DIR="${INDOS_ROOT}/build"
WORK_DIR="${BUILD_DIR}/work"
OUT_DIR="${BUILD_DIR}/out"
AIROOTFS="${WORK_DIR}/x86_64/airootfs"
QEMU_DISK="/tmp/indos-test.qcow2"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

_header() {
    echo -e "\n${BLUE}━━━ ${BOLD}$1${NC}${BLUE} ━━━${NC}"
}

_info() { echo -e "${GREEN}▸${NC} $1"; }
_warn() { echo -e "${YELLOW}▸${NC} $1"; }
_err()  { echo -e "${RED}✗${NC} $1" >&2; }

_elapsed() {
    local start=$1
    local end=$(date +%s)
    local diff=$((end - start))
    echo "$((diff / 60))m $((diff % 60))s"
}

_latest_iso() {
    ls -t "${OUT_DIR}"/indos-*.iso 2>/dev/null | head -1
}

# ─────────────────────────────────────────────────────────────
# COMMANDS
# ─────────────────────────────────────────────────────────────

cmd_build() {
    local full=false
    local skip_models=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full|-f)    full=true; shift ;;
            --no-models)  skip_models=true; shift ;;
            -h|--help)
                echo "Usage: indos-dev build [OPTIONS]"
                echo ""
                echo "Options:"
                echo "  --full, -f      Clean rebuild (delete work dir first)"
                echo "  --no-models     Skip Ollama model pulls (saves ~40s)"
                echo ""
                echo "Default: Incremental build (reuses cached packages)"
                return 0
                ;;
            *) _err "Unknown option: $1"; return 1 ;;
        esac
    done

    _header "Building IndOS ISO"

    if $full; then
        _warn "Full rebuild — clearing work directory..."
        sudo rm -rf "${WORK_DIR}"
    else
        if [[ -d "${WORK_DIR}" ]]; then
            _info "Incremental build (reusing cached packages)"
            _info "Use ${CYAN}--full${NC} for clean rebuild"
        fi
    fi

    # Check if only configs changed (no package changes)
    if [[ -d "${AIROOTFS}" ]] && ! $full; then
        local pkg_hash_file="${WORK_DIR}/.pkg_hash"
        local current_hash
        current_hash=$(md5sum "${ISO_DIR}/packages.x86_64" 2>/dev/null | cut -d' ' -f1)

        if [[ -f "$pkg_hash_file" ]] && [[ "$(cat "$pkg_hash_file")" == "$current_hash" ]]; then
            _info "Package list unchanged — skipping pacstrap"
        else
            _warn "Package list changed — will re-pacstrap"
            # Remove the packages marker to force reinstall
            rm -f "${WORK_DIR}/base._make_packages" 2>/dev/null || true
        fi
    fi

    # Optionally skip model pulling
    if $skip_models; then
        _info "Skipping Ollama model pulls (--no-models)"
        # Temporarily comment out the ollama section
        local customize="${ISO_DIR}/airootfs/root/customize_airootfs.sh"
        if grep -q '^if command -v ollama' "$customize" 2>/dev/null; then
            sudo sed -i 's/^if command -v ollama/if false \&\& command -v ollama/' "$customize"
            trap "sudo sed -i 's/^if false \&\& command -v ollama/if command -v ollama/' '$customize'" EXIT
        fi
    fi

    local start
    start=$(date +%s)

    # Force re-run of customize_airootfs and squashfs on incremental builds
    if [[ -d "${WORK_DIR}" ]] && ! $full; then
        sudo rm -f "${WORK_DIR}/base._make_customize_airootfs" 2>/dev/null || true
        # Remove the ISO build marker to force ISO recreation
        sudo rm -f "${WORK_DIR}/iso._build_iso_image" 2>/dev/null || true
        # Remove squashfs marker
        sudo rm -f "${WORK_DIR}/iso.arch.x86_64._make_airootfs_image_type_squashfs" 2>/dev/null || true
    fi

    sudo bash "${ISO_DIR}/build-iso.sh"

    local iso
    iso=$(_latest_iso)
    echo ""
    _header "Build Complete"
    _info "ISO: ${CYAN}${iso}${NC}"
    _info "Size: $(du -h "$iso" | cut -f1)"
    _info "Time: $(_elapsed "$start")"

    # Save package hash
    md5sum "${ISO_DIR}/packages.x86_64" 2>/dev/null | cut -d' ' -f1 > "${WORK_DIR}/.pkg_hash" 2>/dev/null || true

    echo ""
    _info "Next: ${CYAN}indos-dev test${NC} to boot in QEMU"
}

cmd_test() {
    local ram="4G"
    local cpus="4"
    local snapshot=true
    local disk_size="30G"
    local skip_rebuild=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ram)        ram="$2"; shift 2 ;;
            --cpus)       cpus="$2"; shift 2 ;;
            --persist)    snapshot=false; shift ;;
            --disk)       disk_size="$2"; shift 2 ;;
            --no-rebuild) skip_rebuild=true; shift ;;
            -h|--help)
                echo "Usage: indos-dev test [OPTIONS]"
                echo ""
                echo "Options:"
                echo "  --ram SIZE       RAM for VM (default: 4G)"
                echo "  --cpus N         CPU cores (default: 4)"
                echo "  --persist        Keep disk changes after exit"
                echo "  --disk SIZE      Virtual disk size (default: 30G)"
                echo "  --no-rebuild     Skip inject+rebuild, just boot"
                return 0
                ;;
            *) _err "Unknown option: $1"; return 1 ;;
        esac
    done

    # Auto inject+rebuild if work dir exists (fast path)
    if ! $skip_rebuild && [[ -d "${AIROOTFS}" ]]; then
        cmd_inject
        cmd_rebuild_iso
    fi

    local iso
    iso=$(_latest_iso)
    if [[ -z "$iso" ]]; then
        _err "No ISO found. Run ${CYAN}indos-dev build --full${NC} first."
        return 1
    fi

    local serial_log="/tmp/indos-qemu-serial.log"
    : > "${serial_log}"  # truncate

    _header "Booting IndOS in QEMU"
    _info "ISO: $(basename "$iso")"
    _info "RAM: ${ram} | CPUs: ${cpus} | Disk: ${disk_size}"

    if $snapshot; then
        _info "Mode: ${YELLOW}Snapshot${NC} (disk changes discarded on exit)"
    else
        _info "Mode: ${GREEN}Persistent${NC} (disk changes kept)"
    fi
    echo ""
    _info "SSH:  ${CYAN}ssh indos@localhost -p 2222${NC} (password: indos)"
    _info "Logs: ${CYAN}cat ${serial_log}${NC}"

    # Create disk if needed
    if [[ ! -f "${QEMU_DISK}" ]]; then
        _info "Creating virtual disk..."
        qemu-img create -f qcow2 "${QEMU_DISK}" "${disk_size}" >/dev/null
    fi

    local snapshot_flag=""
    if $snapshot; then
        snapshot_flag="-snapshot"
    fi

    echo ""
    qemu-system-x86_64 \
        -m "${ram}" \
        -smp "${cpus}" \
        -cpu host \
        -enable-kvm \
        -cdrom "${iso}" \
        -drive file="${QEMU_DISK}",if=virtio \
        -device virtio-vga-gl \
        -display gtk,gl=on \
        -device virtio-net-pci,netdev=net0 \
        -netdev user,id=net0,hostfwd=tcp::2222-:22 \
        -serial file:"${serial_log}" \
        ${snapshot_flag}
}

cmd_chroot() {
    if [[ ! -d "${AIROOTFS}" ]]; then
        _err "No built rootfs found. Run ${CYAN}indos-dev build${NC} first."
        return 1
    fi

    _header "Entering IndOS chroot"
    _info "Path: ${AIROOTFS}"
    _info "Type ${CYAN}exit${NC} to leave"
    echo ""

    sudo arch-chroot "${AIROOTFS}" /bin/bash
}

cmd_inject() {
    if [[ ! -d "${AIROOTFS}" ]]; then
        _err "No built rootfs found. Run ${CYAN}indos-dev build${NC} first."
        return 1
    fi

    _header "Injecting configs into rootfs"

    # === Calamares configs ===
    local staging="${ISO_DIR}/airootfs/root/indos-calamares"

    if [[ -d "$staging" ]]; then
        _info "Injecting Calamares configs..."
        sudo cp -f "${staging}/settings.conf" "${AIROOTFS}/etc/calamares/settings.conf"
        sudo cp -f "${staging}/modules/"*.conf "${AIROOTFS}/etc/calamares/modules/"
        sudo cp -rf "${staging}/branding/indos" "${AIROOTFS}/etc/calamares/branding/"
        # Also to /usr/share/calamares/
        sudo cp -f "${staging}/settings.conf" "${AIROOTFS}/usr/share/calamares/settings.conf" 2>/dev/null || true
        sudo cp -rf "${staging}/branding/indos" "${AIROOTFS}/usr/share/calamares/branding/" 2>/dev/null || true
    fi

    # === IndOS settings (niri, waybar, swaync, session) ===
    local settings_src="${INDOS_ROOT}/indos-settings"
    local settings_dst="${AIROOTFS}/usr/share/indos/settings"

    if [[ -d "$settings_src" ]]; then
        _info "Injecting IndOS settings (niri, waybar, session)..."
        sudo mkdir -p "$settings_dst"
        sudo cp -rf "${settings_src}/"* "$settings_dst/"

        # Also update the session script
        if [[ -f "${settings_src}/session/indos-session.sh" ]]; then
            sudo cp -f "${settings_src}/session/indos-session.sh" "${AIROOTFS}/usr/local/bin/indos-session"
            sudo chmod +x "${AIROOTFS}/usr/local/bin/indos-session"
        fi

        # Force-update niri config in skel and live user's home (if user exists)
        if [[ -f "${settings_src}/niri/config.kdl" ]]; then
            sudo mkdir -p "${AIROOTFS}/etc/skel/.config/niri"
            sudo cp -f "${settings_src}/niri/config.kdl" "${AIROOTFS}/etc/skel/.config/niri/config.kdl"
            # Also update existing user's config
            if [[ -d "${AIROOTFS}/home/indos" ]]; then
                sudo mkdir -p "${AIROOTFS}/home/indos/.config/niri"
                sudo cp -f "${settings_src}/niri/config.kdl" "${AIROOTFS}/home/indos/.config/niri/config.kdl"
            fi
        fi
    fi

    _info "Done! All configs injected."
    echo ""
    _info "To test: ${CYAN}indos-dev rebuild-iso${NC} (rebuilds squashfs + ISO only)"
}

cmd_rebuild_iso() {
    if [[ ! -d "${WORK_DIR}" ]]; then
        _err "No work dir. Run ${CYAN}indos-dev build${NC} first."
        return 1
    fi

    _header "Rebuilding ISO (squashfs + xorriso only)"

    local start
    start=$(date +%s)

    # Only remove the squashfs and ISO markers — everything else stays
    sudo rm -f "${WORK_DIR}/iso.arch.x86_64._make_airootfs_image_type_squashfs"
    sudo rm -f "${WORK_DIR}/iso._build_iso_image"

    sudo bash "${ISO_DIR}/build-iso.sh"

    local iso
    iso=$(_latest_iso)
    echo ""
    _info "ISO: ${CYAN}${iso}${NC}"
    _info "Time: $(_elapsed "$start")"
    _info "Next: ${CYAN}indos-dev test${NC}"
}

cmd_calamares() {
    _header "Testing Calamares Config"

    local staging="${ISO_DIR}/airootfs/root/indos-calamares"

    if [[ ! -d "$staging" ]]; then
        _err "No Calamares config found"
        return 1
    fi

    # Validate YAML syntax
    _info "Validating config files..."
    local errors=0

    for f in "${staging}/settings.conf" "${staging}/modules/"*.conf; do
        if python3 -c "import yaml; yaml.safe_load(open('$f'))" 2>/dev/null; then
            echo -e "  ${GREEN}✓${NC} $(basename "$f")"
        else
            echo -e "  ${RED}✗${NC} $(basename "$f") — YAML parse error!"
            errors=$((errors + 1))
        fi
    done

    if [[ $errors -gt 0 ]]; then
        _err "${errors} config file(s) have errors"
        return 1
    fi

    echo ""
    _info "All configs valid!"

    # Show the install sequence
    echo ""
    _info "Install sequence:"
    python3 -c "
import yaml
with open('${staging}/settings.conf') as f:
    cfg = yaml.safe_load(f)
for phase in cfg.get('sequence', []):
    for stage, modules in phase.items():
        print(f'  {stage}:')
        for m in modules:
            print(f'    • {m}')
" 2>/dev/null || _warn "Could not parse sequence (python3-yaml not available)"
}

cmd_status() {
    _header "IndOS Dev Status"

    # Build state
    if [[ -d "${WORK_DIR}" ]]; then
        _info "Work dir: ${GREEN}exists${NC}"

        local markers=0
        local total=0
        for f in "${WORK_DIR}"/base.*; do
            [[ -e "$f" ]] && markers=$((markers + 1))
            total=$((total + 1))
        done
        _info "Build markers: ${markers} completed steps"

        if [[ -d "${AIROOTFS}" ]]; then
            local rootfs_size
            rootfs_size=$(sudo du -sh "${AIROOTFS}" 2>/dev/null | cut -f1)
            _info "Rootfs: ${rootfs_size}"
        fi
    else
        _warn "Work dir: ${RED}not found${NC} — run ${CYAN}indos-dev build${NC}"
    fi

    # ISO
    local iso
    iso=$(_latest_iso)
    if [[ -n "$iso" ]]; then
        _info "Latest ISO: $(basename "$iso") ($(du -h "$iso" | cut -f1))"
        _info "Built: $(stat -c %y "$iso" | cut -d. -f1)"
    else
        _warn "No ISO built yet"
    fi

    # QEMU disk
    if [[ -f "${QEMU_DISK}" ]]; then
        _info "Test disk: ${QEMU_DISK} ($(du -h "${QEMU_DISK}" | cut -f1))"
    fi

    # Config files
    echo ""
    _info "Calamares modules:"
    local staging="${ISO_DIR}/airootfs/root/indos-calamares/modules"
    if [[ -d "$staging" ]]; then
        for f in "${staging}"/*.conf; do
            echo -e "  ${DIM}$(basename "$f")${NC}"
        done
    fi
}

cmd_clean() {
    local all=false
    [[ "${1:-}" == "--all" ]] && all=true

    _header "Cleaning build artifacts"

    if $all; then
        _warn "Removing ALL build artifacts..."
        sudo rm -rf "${BUILD_DIR}"
        rm -f "${QEMU_DISK}"
        _info "Done. Full clean."
    else
        _info "Removing work dir (keeps ISOs)..."
        sudo rm -rf "${WORK_DIR}"
        _info "Done. ISOs preserved in ${OUT_DIR}/"
        _info "Use ${CYAN}--all${NC} to remove everything"
    fi
}

cmd_logs() {
    if [[ ! -d "${AIROOTFS}" ]]; then
        _err "No built rootfs. Run ${CYAN}indos-dev build${NC} first."
        return 1
    fi

    _header "Installed Packages"
    if [[ -f "${WORK_DIR}/iso/arch/pkglist.x86_64.txt" ]]; then
        local count
        count=$(wc -l < "${WORK_DIR}/iso/arch/pkglist.x86_64.txt")
        _info "${count} packages installed"
        echo ""
        cat "${WORK_DIR}/iso/arch/pkglist.x86_64.txt"
    fi
}

cmd_help() {
    echo -e "${BOLD}indos-dev${NC} — IndOS Development Toolkit"
    echo ""
    echo -e "${BOLD}Build Commands:${NC}"
    echo -e "  ${CYAN}build${NC}          Build ISO (incremental by default)"
    echo -e "  ${CYAN}build --full${NC}   Clean rebuild from scratch"
    echo -e "  ${CYAN}build --no-models${NC}  Skip Ollama model pulls"
    echo -e "  ${CYAN}rebuild-iso${NC}    Rebuild squashfs + ISO only (fastest)"
    echo -e "  ${CYAN}inject${NC}         Inject Calamares configs into built rootfs"
    echo ""
    echo -e "${BOLD}Test Commands:${NC}"
    echo -e "  ${CYAN}test${NC}           Boot latest ISO in QEMU (snapshot mode)"
    echo -e "  ${CYAN}test --persist${NC} Boot with persistent disk"
    echo -e "  ${CYAN}chroot${NC}         Enter the built rootfs"
    echo -e "  ${CYAN}calamares${NC}      Validate Calamares configs + show sequence"
    echo ""
    echo -e "${BOLD}Info Commands:${NC}"
    echo -e "  ${CYAN}status${NC}         Show build state and artifacts"
    echo -e "  ${CYAN}logs${NC}           Show installed package list"
    echo -e "  ${CYAN}clean${NC}          Remove work dir (keeps ISOs)"
    echo -e "  ${CYAN}clean --all${NC}    Remove all build artifacts"
    echo ""
    echo -e "${BOLD}Typical Workflow:${NC}"
    echo -e "  ${DIM}# First build${NC}"
    echo -e "  indos-dev build"
    echo -e ""
    echo -e "  ${DIM}# Edit a calamares config, then:${NC}"
    echo -e "  indos-dev inject        ${DIM}# push configs into rootfs${NC}"
    echo -e "  indos-dev rebuild-iso   ${DIM}# ~30s squashfs + ISO${NC}"
    echo -e "  indos-dev test          ${DIM}# boot and verify${NC}"
    echo -e ""
    echo -e "  ${DIM}# Changed packages.x86_64? Need full rebuild:${NC}"
    echo -e "  indos-dev build --full"
}

# ─────────────────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────────────────

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        build)       cmd_build "$@" ;;
        test)        cmd_test "$@" ;;
        chroot)      cmd_chroot "$@" ;;
        inject)      cmd_inject "$@" ;;
        rebuild-iso) cmd_rebuild_iso "$@" ;;
        calamares)   cmd_calamares "$@" ;;
        status)      cmd_status "$@" ;;
        clean)       cmd_clean "$@" ;;
        logs)        cmd_logs "$@" ;;
        help|-h|--help) cmd_help ;;
        *)
            _err "Unknown command: ${cmd}"
            echo ""
            cmd_help
            return 1
            ;;
    esac
}

main "$@"
